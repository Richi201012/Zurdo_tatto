# Credenciales requeridas para /admin. No uses estos valores literalmente.
ADMIN_EMAIL=admin@tu-dominio.com
ADMIN_PASSWORD=cambia-esta-contrasena
ADMIN_SESSION_SECRET=genera-un-secreto-largo-y-aleatorio

# PostgreSQL. Sustituye usuario y contraseña por los valores reales.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@localhost:5432/zurdo_tatto

# Límite por archivo en MB.
MAX_UPLOAD_MB=12

# URL pública y zona horaria del estudio.
APP_URL=http://localhost:3000
STUDIO_TIMEZONE=America/Mexico_City

# Correos transaccionales con Brevo. Nunca uses estas variables en componentes cliente.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_WEBHOOK_SECRET=

# Protege el endpoint que ejecuta recordatorios programados.
CRON_SECRET=
